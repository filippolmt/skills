{
  "mcpServers": {
    "hackerone": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/hackerone/server.py"
      ],
      "env": {
        "HACKERONE_API_USERNAME": "${user_config.hackerone_api_username}",
        "HACKERONE_API_TOKEN": "${user_config.hackerone_api_token}"
      }
    }
  }
}
