{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable\" ] || \"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable.cmd\" (\"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable\" ] || \"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable.cmd\" (\"${PLUGIN_ROOT}/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
