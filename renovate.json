{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.claude-plugin/marketplace\\.json/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://github\\.com/(?<depName>[^\"]+)\",\\s*(?:\"path\":\\s*\"[^\"]+\",\\s*)?\"ref\":\\s*\"(?<currentValue>main|master)\",\\s*\"sha\":\\s*\"(?<currentDigest>[0-9a-f]+)\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.claude-plugin/marketplace\\.json/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://github\\.com/(?<depName>[^\"]+)\",\\s*(?:\"path\":\\s*\"[^\"]+\",\\s*)?\"ref\":\\s*\"(?<currentValue>(?:[a-z][a-z0-9]*-)?v\\d+\\.\\d+\\.\\d+)\",\\s*\"sha\":\\s*\"(?<currentDigest>[0-9a-f]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{depName}}}",
      "versioningTemplate": "regex:^(?<compatibility>[a-z][a-z0-9]*-)?v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "microsoft/playwright-cli keeps 2020 tags from a retired project (v0.4.3 to v0.180.0) that hold no skill and outrank the current v0.1.x series (ADR-0040).",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "microsoft/playwright-cli"
      ],
      "allowedVersions": "!/^v0\\.(4\\.[34]|5\\.[0-2]|15[0-2]\\.0|16[12]\\.0|162\\.1|17[01]\\.0|180\\.0)$/"
    }
  ]
}
